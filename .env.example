# ---------------------------------------------------------------
# Copy to .env  (never commit .env — .gitignore already excludes it)
# Nothing here is required to boot; it all turns features on.
# ---------------------------------------------------------------

PORT=8787
DB_FILE=data/ecoconnect.db
# Set in production. Without it a dev secret is written to data/.jwt-secret
JWT_SECRET=

# ================= VISION =================
# Pick ONE. The key is read by the server only and never reaches a browser.
# After editing, restart the server and run:  npm run check

# --- Option A: Google Gemini ---
GEMINI_API_KEY=
# Default gemini-3.7-flash. gemini-2.0-flash has been shut down.
GEMINI_MODEL=

# --- Option B: OpenAI, or anything speaking the same API ---
OPENAI_API_KEY=
# OpenAI default. For another provider set both of these:
#   Groq     OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   Ollama   OPENAI_BASE_URL=http://localhost:11434/v1
#   OpenRouter OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_BASE_URL=
OPENAI_MODEL=

# Force a provider when both keys are present: gemini | openai
VISION_PROVIDER=

# ================= LOCATION =================
# Nominatim asks for a real contact in the User-Agent. Put yours here.
GEOCODE_USER_AGENT=EcoConnectAI/0.1 (you@example.com)
# Swap in a paid geocoder if you outgrow its 1 req/sec policy.
GEOCODE_ENDPOINT=

# ================= BATCHING =================
BATCH_CRON=*/2 * * * *

# ================= FRONT END (build-time) =================
VITE_API_URL=
VITE_TILE_URL=
